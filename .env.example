# 複製為 .env 後填入。詳細步驟見 README「需要你填入」。
# Copy to .env and fill in. See README section for where to get each value.

# LINE Developers Console → 你的 Messaging API Channel → Basic settings
LINE_CHANNEL_SECRET=
# 同一 Channel → Messaging API 分頁 → Channel access token（先 Issue 一組）
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Mini App 需另建 Service Channel；MVP 可先留空（地圖頁用瀏覽器定位代替）
MINIAPP_CHANNEL_ID=
# Google AI Studio API key；留空時明確顯示知識庫模式
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 回應超時毫秒數；回應慢但後台有成功時可調大（預設 60000）
GEMINI_TIMEOUT_MS=60000
# 已部署的 HTTPS 網站根網址，用於 LINE Rich Menu / webhook 回覆
PUBLIC_BASE_URL=
# 管理員安裝 Rich Menu API 的 Bearer token，勿放在前端
ADMIN_TOKEN=
PORT=3000
# 競賽 Demo 請設 true：固定土地公誕辰 + mock GPS + 啟用 /api/demo/simulate
DEMO_MODE=false
